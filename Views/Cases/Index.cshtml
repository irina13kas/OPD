@{
    ViewData["Title"] = "Cases";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/css/Styles.css" rel="stylesheet" />
</head>
<body>
    <div>
        <nav>
            <div class="heading-title">Кейсы</div>
            <div class="cases-container">
                <div class="image">
                    <img src="/images/кейс1.jpg" alt="Image 1">
                    <img src="/images/кейс2.jpg" alt="Image 2">
                    <img src="/images/кейс3.jpg" alt="Image 3">
                    <img src="/images/кейс4.jpg" alt="Image 4">
                    <img src="/images/кейс5.jpg" alt="Image 5">
                    <img src="/images/кейс6.jpg" alt="Image 6">
                    <img src="/images/кейс7.jpg" alt="Image 7">
                    <img src="/images/кейс8.jpg" alt="Image 8">
                    <button id="showMoreBtn" onclick="showMore()">Показать ещё</button>
                </div>
                <div class="additional-images" style="display: none;">
                    <img src="/images/кейс9.jpg" alt="Image 9">
                    <img src="/images/кейс10.jpg" alt="Image 10">
                    <img src="/images/кейс11.jpg" alt="Image 11">
                    <img src="/images/кейс12.jpg" alt="Image 12">
                </div>
            </div>
        </nav>
    </div>
    <script>
        function showMore() {
            var additionalImages = document.querySelector('.additional-images');
            additionalImages.style.display = 'flex';
            document.getElementById('showMoreBtn').style.display = 'none';
        }
    </script>
</body>
</html>