    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/css/Styles.css" rel="stylesheet" />
</head>

<body>
    <div class="feedback-container">
        <nav>
            <p class="heading-title">ОТЗЫВЫ</p>
            <br />
            <table class="feedback-table">
