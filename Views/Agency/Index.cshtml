@{
    ViewData["Title"] = "Агентство";
}

<head>
    <link href='https://fonts.googleapis.com/css?family=Montserrat' rel='stylesheet'>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link href="~/css/Styles.css" rel="stylesheet" />
</head>

<body>
    <section class="section-main">
        <div class="w-layout-blockcontainer container-2 w-container">
            <h2 class="big-heading">ТРИ ПУТИ</h2>
            <div class="div-block-grid-ways">
                <div class="div-ways">
                    <h3 class="heading-ways">
                        Продавать самостоятельно<br />‍
                    </h3>
                    <p class="paragraph-ways">
                        <strong>Плюсы:</strong>
                        <br />
                        Не надо платить комиссию<br />
                        ‍<br />
                    </p>
                    <p class="paragraph-ways">
                        <strong>Минусы:</strong>
                        <br />
                        О вашем объекте узнают только 10% участников рынка, так как 90% ищут недвижимость через агентов. <br />
                        Вам самим придется торговаться и отбиваться от покупателей, которые будут на вас давить, снижая цену.<br />
                        ‍<br />
                    </p>
                    <p class="paragraph-ways">
                        <strong>Итог: </strong>
                        Будете продавать долго и, в конце концов, продешевите.<br />
                    </p>
                </div>
                <div class="div-ways">
                    <h3 class="heading-ways">Отдать объект на продажу нескольким агентам</h3>
                    <p class="paragraph-ways">
                        <strong>В этом случае вы столкнетесь с рядом рисков:</strong>
                        <br />
                    </p>
                    <ul role="list" class="list-ways">
                        <li>
                            <p class="paragraph-ways">
                                Агенты будут на вас давить, стараясь снизить стоимость, чтобы быстрее продать и получить комиссию.<br />
                            </p>
                        </li>
                        <li class="list-item-3">
                            <p class="paragraph-ways">
                                Агенты будут рекламировать вашу квартиру по разным ценам без вашего ведома.<br />
                            </p>
                        </li>
                        <li>
                            <p class="paragraph-ways">
                                Агенты зачастую будут использовать вашу квартиру для сравнения при продаже других, договорных, объектов.<br />
                            </p>
                        </li>
                        <li>
                            <p class="paragraph-ways">
                                У вас не будет индивидуального маркетингового плана по продвижению объекта на рынок, все действия будут совершаться хаотично.<br />
                            </p>
                        </li>
                        <li>
                            <p class="paragraph-ways">
                                У объекта не будет ответственного, вы не получите обратной связи и отчетов и не будете знать, что происходит на каждом этапе.<br />
                            </p>
                        </li>
                        <li>
                            <p class="paragraph-ways">
                                Профессионалы не возьмутся за продажу объекта без эксклюзива, а значит, вы доверитесь дилетантам.<br />
                            </p>
                        </li>
                    </ul>
                    <p class="paragraph-ways">
                        <strong>Итог: </strong>
                        будете долго продавать, и, если и продадите, то с понижением цены.<br />
                    </p>
                </div>
            </div>
            <div class="div-block-one-ways">
                <h3 class="heading-ways">
                    НАНЯТЬ ПРАВИЛЬНОГО <br />
                    АГЕНТА ПО ЭКСКЛЮЗИВНОМУ <br />ДОГОВОРУ
                </h3>
                <div class="w-layout-grid grid-ways">
                    <img src="/images/photo-about.jpg" loading="lazy" sizes="(max-width: 767px) 94vw, (max-width: 1173px) 92vw, 1080px" srcset="/images/photo-about.jpg 500w, /images/photo-about.jpg 800w, /images/photo-about.jpg 1080w" alt="" class="image-about" />
                    <div id="123" class="div-best-way">
                        <p class="paragraph-ways">
                            <strong>В этом случае вы получите:</strong>
                            <br />
                        </p>
                        <ul role="list" class="list-ways">
                            <li>
                                <p class="paragraph-ways">
                                    Правильную оценку объекта<br />
                                </p>
                            </li>
                            <li class="list-item-3">
                                <p class="paragraph-ways">
                                    Высокую экспозицию по сравнению с конкурентами<br />
                                </p>
                            </li>
                            <li>
                                <p class="paragraph-ways">
                                    Качественную «упаковку» и превосходный маркетинг<br />
                                </p>
                            </li>
                            <li>
                                <p class="paragraph-ways">
                                    Постоянную обратную связь и отчеты от агента<br />
                                </p>
                            </li>
                            <li>
                                <p class="paragraph-ways">
                                    Защиту ваших интересов при переговорах<br />
                                </p>
                            </li>
                        </ul>
                        <p class="paragraph-ways">
                            Профессиональный агент привлечет к продаже вашего объекта всех риэлторов на территории, так как он делится своей комиссией с тем, кто приведет покупателя.<br />
                        </p>
                        <p class="paragraph-ways">
                            <strong>Итог: </strong>
                            объект будет продан в течение 21 дня по максимальной цене (как правило, на 20% дороже, чем, если бы собственник продавал сам).<br />
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>
