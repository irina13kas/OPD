@{
    ViewData["Title"] = "Агентство";
}

<head>
    <link href='https://fonts.googleapis.com/css?family=Montserrat' rel='stylesheet'>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link href="~/css/Styles.css" rel="stylesheet" />
</head>

<body>
    <section class="section-main">
        <div class="w-layout-blockcontainer container-2 w-container">
            <h2 class="big-heading">АГЕНТСТВО</h2>
            <div class="div-agency">
                <div class="div-double-agency">
                    <img src="/images/agency-icon.png" loading="lazy" alt="" class="image-agency-2" />
                    <div class="div-paragraph-agency">
                        <p class="paragraph-agency">
                            Я являюсь членом Ассоциации агентов-аукционистов по операциям с недвижимостью. <br />Наше сообщество насчитывает более 520 агентов-аукционистов, участниками Ассоциации с 2013 года было продано более 25000 объектов недвижимости на сумму более 180 млрд рублей.
                        </p>
                    </div>
                </div>
                <div class="div-paragraph-agency">
                    <p class="paragraph-agency">Основной целью Ассоциации является объединение усилий агентов и брокеров по недвижимости, инвесторов и всех заинтересованных организаций для создания благоприятных условий для развития рынка недвижимости.</p>
                </div>
            </div>
            <h2 class="big-heading">СООБЩЕСТВО</h2>
            <div class="div-agency">
                <div class="div-double-agency">
                    <div class="div-paragraph-agency">
                        <p class="paragraph-agency">Моя команда – Первый Аукционный Бутик Недвижимости (основан Ириной Прохорчук). Это группа высококлассных специалистов с большим опытом работы в Санкт-Петербурге и по всей России. На постоянной основе мы реализуем объекты любого масштаба – от уютных городских квартир до загородных отельных комплексов премиального уровня.</p>
                    </div>
                    <img src="/images/agency.jpg" loading="lazy" alt="" class="image-agency-2" />
                </div>
                <div class="div-paragraph-agency">
                    <p class="paragraph-agency">Также я являюсь партнёром федерального агентства недвижимости «Макромир», которое действует с 2016 года. Партнёрская сеть насчитывает 1845проверенных риэлторов в 66 городах России. </p>
                </div>
            </div>
        </div>
    </section>
    <section class="section-main-consult">
        <div class="w-layout-blockcontainer container-2 w-container">
            <div class="form-block w-form">
                <h5 class="heading-consult">
                    <strong class="bold-text-cons">Если вы хотите получить лучший результат и максимальную выгоду от продажи вашей недвижимости, свяжитесь со мной, чтобы обсудить подробности:</strong>
                </h5>
                <script>
                    // Send a request for a consultation to the corporate email
                    async function sendConsultationEmail() {
                        const name = document.getElementById("name");
                        const phone = document.getElementById("Phone");
                        const email = document.getElementById("Email");
                        const text = "";
                        const response = await fetch('http://89.111.173.104:5000/api/statement', {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json',
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ name: name.value, email: email.value, text, phone: phone.value })
                        });
                        const content = await response.json();

                        name.value = "";
                        email.value = "";
                        phone.value = "";
                    }
                    // Send a request for a seminar to the corporate email
                    async function sendSeminarEmail() {
                        const name = document.getElementById("name");
                        const phone = document.getElementById("Phone");
                        const email = document.getElementById("Email");
                        const consulation = false;
                        const text = "";
                        const response = await fetch('http://89.111.173.104:5000/api/statement', {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json',
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ name: name.value, email: email.value, text, phone: phone.value, consulation })
                        });
                        const content = await response.json();

                        name.value = "";
                        email.value = "";
                        phone.value = "";
                    }
                </script>
                <form id="email-form" name="email-form" data-name="Email Form" method="get" class="form">
                    <div class="w-layout-grid grid-re">
                        <div class="div-block-grid-cons">
                            <label for="name" class="label-cons">Имя</label>
                            <input class="text-field-cons w-input" maxlength="256" name="Name" data-name="Name" placeholder="Имя" type="text" id="name" required />
                        </div>
                        <div class="div-block-grid-cons">
                            <label for="Phone" class="label-cons">Телефон</label>
                            <input class="text-field-cons w-input" maxlength="256" name="Phone" data-name="Phone" placeholder="Телефон" type="tel" id="Phone" required />
                        </div>
                        <div class="div-block-grid-cons">
                            <label for="Email" class="label-cons">Почта</label>
                            <input class="text-field-cons w-input" maxlength="256" name="Email" data-name="Email" placeholder="Почта" type="email" id="Email" required />
                        </div>
                    </div>
                    <input type="button" data-wait="Ожидание" class="submit-button w-button" value="Отправить" onclick="sendConsultationEmail()" />
                </form>
                <div class="success-message w-form-done">
                    <div class="text-confirm">Ваша заявка принята!</div>
                </div>
                <div class="error-message w-form-fail">
                    <div class="text-error">Что-то пошло не так</div>
                </div>
            </div>
        </div>
    </section>
</body>