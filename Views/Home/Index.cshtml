@{
    ViewData["Title"] = "Главная страница";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link href="~/css/Styles.css" rel="stylesheet" />


</head>
<body>

    <div>
        <nav>
            <div class="heading-title-home-container">
                <div class="heading-title">КАК ПРОДАТЬ <br /> НЕДВИЖИМОСТЬ <br /> ПО МАКСИМАЛЬНОЙ ЦЕНЕ <br /> ЗА 21 ДЕНЬ</div>
                <div class="overlay"></div>
                <div class="consl">
                    <a href="#" class="consultation-btn">Запись на консультацию</a>
                </div>
                <div class="numb">
                    <a href="tel:+1234567890" class="phone-btn">Позвонить</a>
                </div>
            </div> 
            <div class="home-container">
                <div class="w-layout-grid grid-about">
                    <div>
                        <img src="/images/photo-about.jpg" loading="lazy" alt="photo-about" class="image-about" />
                    </div>
                    <div class="div-block-about">
                        <h3 class="heading-about">ОБО МНЕ</h3>
                        <p class="paragraph-about">
                            <ul>
                                <li>Меня зовут Расул Аджимурадов</li>
                                <li>Я агент по недвижимости, аттестованный брокер-аукционист</li>
                                <li>Имею более 5 лет опыта работы в продажах</li>
                                <li>Продаю недвижимость по максимальной цене в конкретный срок</li>
                                <li>Специалист по маркетингу и продажам</li>
                                <li>Прошёл обучение у автора аукционного метода продажи недвижимости, Александра Санкина, с 26-летним международным опытом</li>
                            </ul>
                        </p>
                    </div>
                </div>
                <div class="home-about"
                    <div class="div-block-about">
                        <p class="paragraph-about">
                            Если вы хотите дорого и быстро продать свою недвижимость или сделать выгодную
                            покупку для жизни или инвестиций – запишитесь ко мне на бесплатную
                            консультацию!
                        </p>
                        <div class="consl">
                            <a href="#" class="consultation-btn">Запись на консультацию</a>
                        </div>
                    </div>
                </div>
                
                
                <div class="carousel">
                    <div class="carousel-item">
                        <img src="/images/кейс1.jpg" alt="Image 13">
                        <div class="car-text-block">Кейс: Glass House в Подмосковье <br /> Смоимость: 30млн <br /> Продано за 19 дней</div>
                    </div>
                    <div class="carousel-item">
                        <img src="/images/кейс2.jpg" alt="Image 14">
                        <div class="car-text-block">Кейс: Небоскрёб в Москве <br /> Смоимость: 150млн <br /> Продано за 21 день</div>
                    </div>
                    <div class="carousel-item">
                        <img src="/images/кейс3.jpg" alt="Image 15">
                        <div class="car-text-block">Кейс: Домик в лесу в ЛО <br /> Смоимость: 12млн <br /> Продано за 17 дней</div>
                    </div>
                    <div class="carousel-item">
                        <img src="/images/кейс4.jpg" alt="Image 16">
                        <div class="car-text-block">Текст для изображения 4</div>
                    </div>
                    <div class="carousel-item">
                        <img src="/images/кейс5.jpg" alt="Image 17">
                        <div class="car-text-block">Текст для изображения 5</div>
                    </div>
                    <div class="carousel-item">
                        <img src="/images/кейс6.jpg" alt="Image 18">
                        <div class="car-text-block">Текст для изображения 6</div>
                    </div>
                    <div class="carousel-item">
                        <img src="/images/кейс7.jpg" alt="Image 19">
                        <div class="car-text-block">Текст для изображения 7</div>
                    </div>
                    <div class="carousel-item">
                        <img src="/images/кейс8.jpg" alt="Image 20">
                        <div class="car-text-block">Текст для изображения 8</div>
                    </div>
                </div>
            </div>
        </nav>
    </div>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel/slick/slick.css" />

    <!-- Подключение CSS темы Slick (по желанию) -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel/slick/slick-theme.css" />

    <!-- Подключение JavaScript Slick -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel/slick/slick.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/slick-carousel/slick/slick.min.js"></script>
    <script src="script.js"></script>
    <script>
        document.querySelectorAll('.carousel-item').forEach(function (carousel- item) {
            var img = carousel - item.querySelector('img');
            var textBlock = carousel - item.querySelector('.car-text-block');

            carousel - item.addEventListener('mouseenter', function () {
                textBlock.style.display = 'block';
            });

            carousel - item.addEventListener('mouseleave', function () {
                textBlock.style.display = 'none';
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('.carousel').slick({
                slidesToShow: 4,
                slidesToScroll: 1,
                infinite: true,
                arrows: true,
                prevArrow: '<button type="button" class="slick-prev">Previous</button>',
                nextArrow: '<button type="button" class="slick-next">Next</button>',
                responsive: [
                    {
                        breakpoint: 768,
                        settings: {
                            slidesToShow: 2
                        }
                    },
                    {
                        breakpoint: 480,
                        settings: {
                            slidesToShow: 1
                        }
                    }
                ]
            });
        });
    </script>
    
</body>
</html>
